# Copy to .env.local only when you need non-default build settings.
# Never put SMTP, API or other private credentials in NEXT_PUBLIC_* variables.
SITE_URL=https://biovent-implant.com
NEXT_PUBLIC_BASE_PATH=
# Empty endpoints keep the two forms in honest preview mode.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
NEXT_PUBLIC_PROFESSIONAL_ENQUIRY_ENDPOINT=
# Enable only after TLS/proxy behavior is verified on the actual host.
BIOVENT_FORCE_HTTPS=0
